# Non-secret local shape only. Store production secrets in Secret Manager.
GMA_MCP_ENV=development
GMA_MCP_OAUTH_STORAGE=memory
GMA_MCP_SEARCH_MAX_ROWS=1000
# Optional production boundary. When set, callers cannot select another MCC.
GMA_MCP_ENFORCED_LOGIN_CUSTOMER_ID=2073274070
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_ADS_MCP_BASE_URL=http://localhost:8080
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=your-web-client-id
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=your-web-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
